node_modules/
dist/
build/
# Vendored upstream checkouts (cloned at the SHAs in PINNED.txt) and
# anything else cached under vendor/ — but PINNED.txt itself is the
# tracked pin file the build pipeline reads.
vendor/*
!vendor/PINNED.txt
.DS_Store
*.log

# `npm pack` / release tarball output.
*.tgz

# Cloudflare Workers / Wrangler artifacts (added when the Worker lands).
.wrangler/
.wrangler-state/
.wrangler-dryrun/
worker/node_modules/
worker/.wrangler/
worker/.wrangler-state/
worker/worker-configuration.d.ts
# worker/public/ is the VitePress docs build, staged here for wrangler
# to bundle as static assets. Generated by `npm run worker:assets`;
# rebuilt on every deploy.
worker/public/

# VitePress docs site build outputs.
docs/.vitepress/dist/
docs/.vitepress/cache/

# Auto-generated docs pages (npm run docs:data):
#   - snapshots.md: rendered from build/*.json pins; changes every refresh.
#   - changelog.md: copy of repo-root CHANGELOG.md (the source of truth).
# tools.md is intentionally tracked so a fresh clone / GitHub browse
# gets the full tool reference without a build step.
docs/snapshots.md
docs/changelog.md
